# انسخ هذا الملف باسم .env وعدّل القيم حسب بيئتك

# رابط الاتصال بقاعدة بيانات MongoDB
# محلياً (بعد تثبيت MongoDB على جهازك):
MONGO_URI=mongodb://127.0.0.1:27017/alwaha

# أو استخدم MongoDB Atlas (سحابي ومجاني):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/alwaha

# منفذ تشغيل الخادم
PORT=5000

# مفتاح سري لتوقيع رموز الدخول (JWT) - غيّره لأي نص عشوائي طويل
JWT_SECRET=change_this_to_a_long_random_secret_key

# بيانات دخول الأدمن الافتراضية (تُستخدم عند تشغيل seed.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# رابط الفرونت إند المسموح له بالوصول للباك إند (CORS)
# محلياً يكفي الرابط الافتراضي، وبعد النشر غيّره لرابط موقعك الحقيقي
# يمكن وضع أكثر من رابط مفصولين بفاصلة، مثال:
# FRONTEND_URL=https://trendshop.com,https://www.trendshop.com
FRONTEND_URL=http://localhost:5173
